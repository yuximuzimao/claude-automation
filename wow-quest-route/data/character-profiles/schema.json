{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wow-quest-route/character-profile/v1",
  "title": "WoW Quest Route Character Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "character_profile_id",
    "game_variant_id",
    "faction",
    "race",
    "class",
    "party_size",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "character_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "game_variant_id": {
      "type": "string",
      "minLength": 1
    },
    "faction": {
      "enum": [
        "horde",
        "alliance"
      ]
    },
    "race": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "party_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
