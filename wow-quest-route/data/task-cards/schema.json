{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wow-quest-route/task-card/v1",
  "title": "WoW Quest Route Task Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "identity",
    "coverage",
    "availability",
    "rewards",
    "guide",
    "fivebox",
    "timing_rule_ref",
    "evidence",
    "presentation"
  ],
  "$defs": {
    "coverage_status": {
      "enum": [
        "unknown",
        "partial",
        "verified",
        "not_applicable"
      ]
    },
    "confidence": {
      "enum": [
        "verified",
        "partial",
        "expected",
        "unknown"
      ]
    },
    "reward_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "quantity",
        "name_zhcn",
        "name_en",
        "sell_price_each_copper",
        "sell_price_total_copper"
      ],
      "properties": {
        "item_id": {
          "type": "integer",
          "minimum": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "name_zhcn": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "sell_price_each_copper": {
          "type": "integer",
          "minimum": 0
        },
        "sell_price_total_copper": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "integer",
      "minimum": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_zhcn",
        "game_variant_id",
        "version_scope",
        "faction",
        "repeatability"
      ],
      "properties": {
        "name_zhcn": {
          "type": "string",
          "minLength": 1
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "game_variant_id": {
          "type": "string",
          "minLength": 1
        },
        "version_scope": {
          "type": "string",
          "minLength": 1
        },
        "faction": {
          "enum": [
            "horde",
            "alliance",
            "both",
            "unknown"
          ]
        },
        "repeatability": {
          "enum": [
            "once",
            "daily",
            "repeatable",
            "unknown"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "rewards",
        "guide"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/coverage_status"
        },
        "rewards": {
          "$ref": "#/$defs/coverage_status"
        },
        "guide": {
          "$ref": "#/$defs/coverage_status"
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quest_level",
        "min_level",
        "pre_any",
        "pre_all",
        "parent_active",
        "exclusive_with",
        "hidden_requirements"
      ],
      "properties": {
        "quest_level": {
          "type": [
            "integer",
            "null"
          ]
        },
        "min_level": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pre_any": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "pre_all": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "parent_active": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "exclusive_with": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "required_reputation": {
          "type": [
            "object",
            "null"
          ]
        },
        "required_class": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_race": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_skill": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hidden_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "summary",
              "confidence"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "$ref": "#/$defs/confidence"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_xp": {
          "type": "integer",
          "minimum": 0
        },
        "no_money_from_xp": {
          "type": "boolean"
        },
        "reward_money_copper": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reward_item"
          }
        },
        "choice_items_desc_by_sell": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reward_item"
          }
        },
        "fixed_items_sell_total_copper": {
          "type": "integer",
          "minimum": 0
        },
        "choice_item_max_sell_copper": {
          "type": "integer",
          "minimum": 0
        },
        "gear_sale_max_copper": {
          "type": "integer",
          "minimum": 0
        },
        "reputation_rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "faction_id",
              "amount"
            ],
            "properties": {
              "faction_id": {
                "type": "integer",
                "minimum": 1
              },
              "amount": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "guide": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fivebox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "shared",
            "not_shared",
            "sequential_loot",
            "special",
            "pending",
            "not_applicable"
          ]
        }
      }
    },
    "timing_rule_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_type",
          "source_ref",
          "observed_at",
          "confidence",
          "supports_fields"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "user_live",
              "questie",
              "local_db",
              "public_reference",
              "derived",
              "legacy_migration"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "version_scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "supports_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note_override": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "text",
            "scope",
            "source_ref",
            "reason"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "pattern": "^(all|route_profile:[a-z0-9][a-z0-9-]*)$"
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "show_on": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "accept",
                  "objective",
                  "turnin"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "action_display_override": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "suppress_kinds",
            "scope",
            "source_ref",
            "reason"
          ],
          "properties": {
            "suppress_kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "accept",
                  "objective",
                  "turnin"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "scope": {
              "type": "string",
              "pattern": "^(all|route_profile:[a-z0-9][a-z0-9-]*)$"
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
