          "flow": "在梅雷多尔处接取，下桥到旁边水里找到元素魔典，五个角色各点击或拾取一次，再回梅雷多尔交付。",
          "fivebox": "固定地点只需要1个物品；虽然要逐号操作，但每号只有一次，不属于高负担收集。"
        },
        "9358": {
          "location": "晴风村旅店 → 游侠萨蕾恩",
          "flow": "从旅店老板接取，去晴风村东南侧向游侠萨蕾恩报到。",
          "fivebox": "纯跑腿任务，五个角色分别接取和交付。"
        },
        "9252": {
          "location": "游侠萨蕾恩周围",
          "flow": "接取后在附近分别击杀4个腐肢劫掠者和4个黑暗怨灵，再回萨蕾恩交付。",
          "fivebox": "普通击杀任务，预计组队共享；以五个角色进度都完成为准。"
        },
        "8463": {
          "location": "鹰翼广场北侧废墟",
          "flow": "在艾尔杜·炙痕处接取，在北侧废墟收集6块不稳定的法力水晶，再回鹰翼广场交付。",
          "fivebox": "6个地面物品需要五个角色分别取得，相当于最多30次个人收集，标红并移至补经验。"
        },
        "8472": {
          "location": "鹰翼广场北侧废墟",
          "flow": "在魔导师亚隆尼斯处接取，击杀奥术巡逻者并收集6枚奥术核心，再回鹰翼广场交付。",
          "fivebox": "普通怪掉落6个任务物品，五个角色分别计算，随机掉落与数量同时放大，属于高负担收集。"
        },
        "8482": {
          "location": "阳帆港东北侧的达纳苏斯斥候区域",
          "flow": "击杀达纳苏斯斥候时可能掉落秘密文件；拾取后触发任务，回鹰翼广场交给艾尔杜·炙痕。",
          "fivebox": "随机掉落触发任务；只在顺路掉落时接，不建议为了它反复刷怪。"
        },
        "8491": {
          "location": "晴风村周围的魔泉豹区域",
          "flow": "在维兰·布雷托克处接取，收集6张魔泉豹皮后返回交付。",
          "fivebox": "普通怪掉落6张豹皮，五个角色分别计算，属于高负担收集。"
        },
        "8480": {
          "location": "阳帆港东侧营地 → 营地西南侧军备区域",
          "flow": "在维雷迪斯·雪晨处接取，到军备区域收集8件辛多雷军备，再回营地交付。",
          "fivebox": "8件地面军备需要五个角色分别取得，相当于最多40次个人收集，属于高负担任务。"
        },
        "8886": {
          "location": "阳帆港东侧营地 → 西海岸鱼人区域",
          "flow": "在凯莉森德拉船长处接取，夺回6份货物后返回营地交付。",
          "fivebox": "6份货物需要五个角色分别完成，属于高负担收集。"
        },
        "8887": {
          "location": "西海岸鱼人区域 → 阳帆港东侧营地",
          "flow": "击杀暗鳞鱼人时可能掉落航海图；拾取后触发任务，交给凯莉森德拉船长。",
          "fivebox": "随机掉落触发任务；只在做其他鱼人任务时顺路完成，不建议单独等待。"
        },
        "8884": {
          "location": "哈斯温里奥 → 西海岸鱼人区域 → 哈斯温里奥",
          "flow": "从哈斯温里奥处接取，在西海岸收集8个鱼人任务物品，再返回交付。",
          "fivebox": "8个普通怪掉落物需要五个角色分别收集，随机掉落与总数量乘以5，属于典型高负担任务。"
        },
        "8885": {
          "location": "哈斯温里奥（29.89,58.43）→ 西海岸巡逻线（约26.16,66.15至24.37,74.31）",
          "flow": "必须先完成《鱼头......》并在哈斯温里奥处接取；沿西海岸向南寻找巡逻的呜啦哇啦，击杀后五个角色各拾取一次，再回哈斯温里奥交付。",
          "fivebox": "固定命名怪只需要1枚戒指，拾取本身负担低；耗时主要来自长巡逻路线和可能等待刷新。",
          "note": "地图上的多个标记代表任务区域或巡逻路径，不是四个固定NPC。"
        },
        "9076": {
          "location": "阳帆港东侧营地 → 鲁莽的奥尔达隆（约32.8,69.4）→ 营地",
          "flow": "必须先完成《失落的军备》；在维雷迪斯·雪晨处接取，击杀鲁莽的奥尔达隆，五个角色各拾取一次，再返回交付。",
          "fivebox": "固定命名怪只需要1个任务物品，本身负担低；但它依赖高负担的《失落的军备》。"
        }
      }
