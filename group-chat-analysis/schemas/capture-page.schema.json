{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capture-page.schema.json",
  "title": "Group Chat Raw Capture Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "page_index",
    "group_key",
    "group_display",
    "source",
    "observed_at",
    "window",
    "coordinate_space",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "page_index": {
      "type": "integer",
      "minimum": 0
    },
    "group_key": {
      "type": "string",
      "minLength": 1
    },
    "group_display": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "const": "qq_history_window_ocr"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "title",
        "width",
        "height"
      ],
      "properties": {
        "window_id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coordinate_space": {
      "const": "vision_normalized_bottom_left"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_index",
          "text",
          "bbox",
          "confidence"
        ],
        "properties": {
          "block_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
